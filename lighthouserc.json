{
  "ci": {
    "collect": {
      "settings": {
        "extraHeaders": { "x-vercel-skip-toolbar": "1" }
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.98 }],
        "categories:best-practices": ["error", { "minScore": 0.98 }],
        "categories:seo": ["off"],
        "categories:performance": ["off"]
      }
    }
  }
}
